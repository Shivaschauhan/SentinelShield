<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Rounded Squircle Base (rx=30) -->
    <path android:pathData="M30,0 L90,0 A30,30 0 0,1 120,30 L120,90 A30,30 0 0,1 90,120 L30,120 A30,30 0 0,1 0,90 L0,30 A30,30 0 0,1 30,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="120"
                android:endY="120">
                <item android:color="#FF0F2027" android:offset="0.0" />
                <item android:color="#FF203A43" android:offset="0.5" />
                <item android:color="#FF2C5364" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Shield Background & Rim -->
    <path
        android:fillColor="#1AFFFFFF"
        android:pathData="M60,20 L95,35 V60 C95,85 75,105 60,110 C45,105 25,85 25,60 V35 Z"
        android:strokeWidth="2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="60"
                android:startY="20"
                android:endX="60"
                android:endY="110">
                <item android:color="#FF4FACFE" android:offset="0.0" />
                <item android:color="#FF00F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Shield Soft Glow Halos -->
    <path
        android:fillColor="#00000000"
        android:pathData="M60,30 L85,42 V62 C85,80 70,95 60,100 C50,95 35,80 35,62 V42 Z"
        android:strokeColor="#2400F2FE"
        android:strokeLineJoin="round"
        android:strokeWidth="8" />
    <path
        android:fillColor="#00000000"
        android:pathData="M60,30 L85,42 V62 C85,80 70,95 60,100 C50,95 35,80 35,62 V42 Z"
        android:strokeColor="#484FACFE"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />

    <!-- Inner Shield Core -->
    <path android:pathData="M60,30 L85,42 V62 C85,80 70,95 60,100 C50,95 35,80 35,62 V42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="60"
                android:startY="30"
                android:endX="60"
                android:endY="100">
                <item android:color="#FF4FACFE" android:offset="0.0" />
                <item android:color="#FF00F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central 'S' Emblem -->
    <path
        android:fillColor="#00000000"
        android:pathData="M67.5,50 C57.5,50 47.5,50 47.5,60 C47.5,70 72.5,70 72.5,80 C72.5,90 57.5,90 47.5,90 M47.5,50 L57.5,50"
        android:strokeColor="#FF0F2027"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="6" />
</vector>
